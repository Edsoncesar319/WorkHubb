// Prisma schema — WorkHubb (Vercel Postgres / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled — runtime (Vercel: POSTGRES_PRISMA_URL → DATABASE_URL via ensure-prisma-build-env)
  url       = env("DATABASE_URL")
  // Direct — migrations (Vercel injeta POSTGRES_URL_NON_POOLING ou DATABASE_URL_UNPOOLED)
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  type         String
  bio          String?
  stack        String?
  github       String?
  linkedin     String?
  company      String?
  profilePhoto   String?  @map("profile_photo")
  resumeUrl      String?  @map("resume_url")
  resumeFileName String?  @map("resume_file_name")
  createdAt      DateTime @default(now()) @map("created_at")

  jobs         Job[]
  applications Application[]
  experiences  Experience[]

  @@map("users")
}

model Job {
  id           String   @id
  title        String
  company      String
  location     String
  remote       Boolean
  salary       String?
  description  String
  requirements String
  authorId     String   @map("author_id")
  createdAt    DateTime @default(now()) @map("created_at")

  author       User          @relation(fields: [authorId], references: [id])
  applications Application[]

  @@map("jobs")
}

model Application {
  id        String   @id
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@map("applications")
}

model Experience {
  id          String   @id
  userId      String   @map("user_id")
  title       String
  company     String
  location    String?
  startDate   String   @map("start_date")
  endDate     String?  @map("end_date")
  current     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("experiences")
}
