# Copie para .env.local e preencha (ou: vercel env pull .env.development.local)

# Vercel Postgres — use a URL direta postgres:// (obrigatório para a app)
# Após: vercel env pull .env.development.local
WORKHUB_POSTGRES_URL=
WORKHUB_POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Prisma (opcional; não use só prisma+... para Drizzle/API)
DATABASE_URL=
WORKHUB_DATABASE_URL=

# Vercel Blob — upload de fotos (opcional)
BLOB_READ_WRITE_TOKEN=
