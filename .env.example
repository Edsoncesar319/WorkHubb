# Copie para .env.local e preencha (ou: vercel env pull .env.development.local)

# Vercel Postgres (obrigatório)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Prisma (opcional — lib/db/env.ts copia de POSTGRES_* se vazio)
DATABASE_URL=

# Vercel Blob — upload de fotos (opcional)
BLOB_READ_WRITE_TOKEN=
